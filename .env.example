NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Use the same approved company account in both settings. The public value is
# used only to render the correct UI; server routes independently enforce the
# private value.
PLATFORM_OWNER_EMAIL=
NEXT_PUBLIC_PLATFORM_OWNER_EMAIL=

# Generate a random value of at least 32 characters and store it only in the
# deployment secret manager. Do not commit the real value.
API_KEY_ENCRYPTION_SECRET=

# Optional server-side fallbacks. Prefer the encrypted Admin API Key Vault.
INTERCOM_API_KEY=
OPENAI_API_KEY=
